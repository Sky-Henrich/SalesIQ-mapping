void automation.Lead_Source(String leadId)
{
// ===== SalesIQ chatbot (Add Lead card) leads arrive as "Chat" -> "SalesIQ" =====
// Updates go through crm_connection so the lead shows "Modified by" the user who authorized that connection
leadRecord = zoho.crm.getRecordById("Leads",leadId);
leadSource = leadRecord.get("Lead_Source");
if(leadSource != null && leadSource.trim() == "Chat")
{
	updateMap = Map();
	updateMap.put("Lead_Source","SalesIQ");
	updateResult = zoho.crm.updateRecord("Leads",leadId,updateMap,Map(),"crm_connection");
	info updateResult;
	if(updateResult.get("id") == null)
	{
		// Connection failed (e.g. missing scope or being reconnected): update without it
		updateResult = zoho.crm.updateRecord("Leads",leadId,updateMap);
		info updateResult;
	}
	// ===== Chatbot leads only: remove SalesIQ's "chat with Customer" note when its only question is the language button =====
	// Language is already synced to its own field. Notes with a real question are kept.
	// Requires crm_connection to include scope ZohoCRM.modules.notes.ALL
	leadNotes = zoho.crm.getRelatedRecords("Notes","Leads",leadId);
	info "Notes found: " + leadNotes.size();
	for each note in leadNotes
	{
		// SalesIQ may put the heading in the title or the content, with HTML or line breaks,
		// so compare letters and digits only: "Question : English<br>" -> "questionenglishbr"
		rawText = ifnull(note.get("Note_Title"),"") + " " + ifnull(note.get("Note_Content"),"");
		info "Note " + note.get("id") + ": " + rawText;
		plainText = rawText.getAlphaNumeric().toLowerCase();
		if(plainText.endsWith("br"))
		{
			plainText = plainText.subString(0,plainText.length() - 2);
		}
		isSalesIQNote = plainText.contains("zohosalesiqchatwithcustomer");
		isLanguageOnly = plainText.endsWith("questionenglish") || plainText.endsWith("questionespañol") || plainText.endsWith("questionespaol") || plainText.endsWith("questionespanol");
		if(isSalesIQNote && isLanguageOnly)
		{
			noteDelete = invokeurl
			[
				url :"https://www.zohoapis.com/crm/v8/Notes?ids=" + note.get("id")
				type :DELETE
				connection:"crm_connection"
			];
			info noteDelete;
		}
	}
}
// ===== Clear the Company SalesIQ fills in from the email domain (podav@abowned.com -> "abowned") =====
// The chatbot never asks for a company, so a value equal to the email domain name is not real.
// Runs on every call: SalesIQ pushes it in a later sync, not when the lead is created.
companyValue = ifnull(leadRecord.get("Company"),"").trim();
emailValue = ifnull(leadRecord.get("Email"),"").trim();
if(companyValue != "" && emailValue.contains("@"))
{
	emailDomainName = emailValue.getSuffix("@").getPrefix(".");
	if(emailDomainName != null && companyValue == emailDomainName)
	{
		companyMap = Map();
		companyMap.put("Company",null);
		companyResult = zoho.crm.updateRecord("Leads",leadId,companyMap,Map(),"crm_connection");
		info "Cleared email-domain Company \"" + companyValue + "\": " + companyResult;
	}
}
}
